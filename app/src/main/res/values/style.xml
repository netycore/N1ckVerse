<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================================
         N1ckVerse Theme System
         Theme 0: Dark (AppCompat Dark)
         Theme 1: Light (Material3 Light)
         Theme 2: Light + Dark ActionBar (M3 Day/Night default) ← default
         Theme 3: Day/Night auto
         Theme 4: AMOLED (pure black)
         ============================================= -->

    <!-- Dark theme (AppCompat-based for legacy consistency) -->
    <style name="Theme" parent="Theme.AppCompat">
        <item name="backspace">@drawable/ic_action_backspace</item>
        <item name="cancel">@drawable/ic_action_cancel</item>
        <item name="search">@drawable/ic_action_search</item>
        <item name="drag_handle">@drawable/ic_drag_handle</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Light theme -->
    <style name="Theme.Light" parent="Theme.AppCompat.Light">
        <item name="backspace">@drawable/ic_action_backspace_light</item>
        <item name="cancel">@drawable/ic_action_cancel_light</item>
        <item name="search">@drawable/ic_action_search_light</item>
        <item name="drag_handle">@drawable/ic_drag_handle_light</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Light + Dark Action Bar (default) -->
    <style name="Theme.Light.DarkActionBar" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="backspace">@drawable/ic_action_backspace_light</item>
        <item name="cancel">@drawable/ic_action_cancel_light</item>
        <item name="search">@drawable/ic_action_search_light</item>
        <item name="drag_handle">@drawable/ic_drag_handle_light</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Day/Night auto — Light variant (night override is in values-night/) -->
    <style name="Theme.DayNight" parent="Theme.Light" />

    <!-- AMOLED: pure black background for OLED power savings -->
    <style name="Theme.AMOLED" parent="Theme.AppCompat">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorPrimary">@color/amoled_primary</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@color/amoled_accent</item>
        <item name="android:textColorPrimary">@color/amoled_text</item>
        <item name="android:textColorSecondary">@color/amoled_text_secondary</item>
        <item name="backspace">@drawable/ic_action_backspace</item>
        <item name="cancel">@drawable/ic_action_cancel</item>
        <item name="search">@drawable/ic_action_search</item>
        <item name="drag_handle">@drawable/ic_drag_handle</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <!-- Material 3 base (used for M3 color resolution) -->
    <style name="Theme.N1ckVerse" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="backspace">@drawable/ic_action_backspace_light</item>
        <item name="cancel">@drawable/ic_action_cancel_light</item>
        <item name="search">@drawable/ic_action_search_light</item>
        <item name="drag_handle">@drawable/ic_drag_handle_light</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

</resources>
